# Temp files
.DS_Store
*~
buck-out/
/core

# Compiled files
.venv/
__pycache__/
.*cache/

# Secrets / API keys
.env

# Distribution / packaging
/dist/

# Tests and coverage
/results/
/saved_job_logs/
/node_modules/
/.coverage*

# docs
/docs/generated/
/docs/_build/

# Notebook data caches — analysis outputs, large; live on RDS, not in git
**/notebooks/_data/

# Everything in /logs
/logs/

# Run logs
*.log
*.out
*.err

# Saved images
*.png

# ARIBA prepareref outputs — large per-DB build artefact (CD-HIT clusters,
# bowtie2 indexes); rebuilt by `bac_ariba.pp.build_ariba_ref`.
src/bac_ariba/refs/*/prepareref_out/

# bac_agentic_metadata engine — never commit OAuth secrets/tokens or the raw ENA cache.
# (Off-OneDrive credentials live under ~/.config/bac_metadata/ by default; see engine/gsheet.py.)
**/client_secret*.json
**/token.json
src/bac_metadata/bac_agentic_metadata/applications/*/data/ena_cache/

