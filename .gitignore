# Temp files
.DS_Store
*~
buck-out/
/core

# Compiled files
.venv/
__pycache__/
.*cache/

# Secrets / API keys
.env

# Distribution / packaging
/dist/

# Tests and coverage
/results/
/saved_job_logs/
/node_modules/
/.coverage*

# docs
/docs/generated/
/docs/_build/

# Notebook data caches — analysis outputs, large; live on RDS, not in git
**/notebooks/_data/

# Everything in /logs
/logs/

# Run logs
*.log
*.out
*.err

# Saved images
*.png

# ARIBA prepareref outputs — large per-DB build artefact (CD-HIT clusters,
# bowtie2 indexes); rebuilt by `bac_ariba.pp.build_ariba_ref`.
src/bac_ariba/refs/*/prepareref_out/

# bac_agentic_metadata engine — never commit OAuth secrets/tokens, API keys, or raw caches.
# (Off-OneDrive credentials live under ~/.config/bac_metadata/ by default; see engine/gsheet.py.)
**/client_secret*.json
**/token.json
**/anthropic_api_key
# All regenerable caches now live under data/cache/ (llm, ena, fulltext, find, per_sample_*).
src/bac_metadata/bac_agentic_metadata/applications/*/data/cache/
# Pre-built full-width per-sample base table — large + regenerable from the collation via export_base_table.py.
src/bac_metadata/bac_agentic_metadata/applications/*/data/inputs/base_table.csv
# Manually-downloaded paywalled paper PDFs — copyrighted + large; reproduce with engine.cli.attach_papers.
src/bac_metadata/bac_agentic_metadata/applications/*/data/find_papers/manual_download/
# Manually-downloaded supplementary tables (manual_download_supp/) are deliberately TRACKED: a curator table
# that is not version-controlled gets silently lost (this is what dropped PRJEB28400's per-isolate table in the
# OneDrive->developer migration, taking its isolation_source to 0%). They are small, and losing one is worse
# than storing it. Consumed by engine/local_supplements.py; linkability tracked by evaluation/table_linkability.py.
# Filled full-width metadata tables + provenance (the driver's fill-metadata-table stage substitutes agent
# values into the whole base row) are deliberately TRACKED: this is the pipeline's PRODUCTION output, and the
# escalation-conservation gate diffs it vs git HEAD (INV2/INV3) to prove no curator answer is silently lost.
# They regenerate from the applied files via engine.cli.fill, but keeping them version-controlled is the point.

# pixi-solved tool environments (manifest + lock are tracked; the env dir is not)
.pixi/

